{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "0.2.0",
  "description": "Export ChatGPT, Claude, Gemini, Grok, Google AI Overviews and AI Mode to Markdown, locally and privately.",
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://google.com/*",
    "*://*.chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://*.openai.com/*",
    "*://*.oaiusercontent.com/*",
    "*://*.claude.ai/*",
    "*://*.claude.com/*",
    "*://*.claudeusercontent.com/*",
    "*://*.anthropic.com/*",
    "*://*.gemini.google.com/*",
    "*://*.googleusercontent.com/*",
    "*://*.googleapis.com/*",
    "*://*.gstatic.com/*",
    "*://*.grok.com/*",
    "*://*.x.ai/*",
    "*://*.blob.core.windows.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
